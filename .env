# GA4 measurement id for dom-meszna.pl.
#
# Committed deliberately: this is not a credential. It is compiled into the
# client bundle and served in the page to every visitor, so keeping it out of
# the repo would buy no secrecy and would instead make analytics depend on a
# dashboard setting that is invisible from the code.
#
# Next.js reads this at build time, so Netlify picks it up on deploy with no
# further configuration. An environment variable set in the Netlify UI takes
# precedence over this file if one is ever added there.
NEXT_PUBLIC_GA_ID=G-NVQQGRQ6HS
