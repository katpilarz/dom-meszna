# Analytics is off until this is set. Left empty, the site makes no third-party
# requests at all and the consent banner stays hidden — there is nothing to
# consent to, and a banner on a site that tracks nothing is noise, not
# compliance.
#
# Set it to a GA4 measurement id (G-XXXXXXXXXX) to turn analytics on. The banner
# then appears automatically, and no Google script is loaded until a visitor
# actively agrees.
NEXT_PUBLIC_GA_ID=
